{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "powerbi-authoring-local": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/powerbi-modeling-mcp@latest",
        "--start"
      ],
      "environment": {
        "PBI_MODELING_MCP_ACCEPT_EULA": "true"
      },
      "enabled": true
    }
  }
}