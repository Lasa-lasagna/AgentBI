{
	"name": "agentbi",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"pbi:status": "powerbi-desktop status",
		"pbi:reload": "powerbi-desktop reload",
		"pbi:captura": "powerbi-desktop screenshot",
		"pbi:capturas": "powerbi-desktop screenshot-all --output-dir capturas --scale 2",
		"pbi:preview": "powerbi-report-author preview",
		"pbi:validate": "powerbi-report-author validate",
		"pbi:doctor": "powerbi-report-author doctor",
		"tokens": "node --no-warnings scripts/tokens.mjs"
	},
	"devDependencies": {
		"@microsoft/powerbi-desktop-bridge-cli": "^1.0.0",
		"@microsoft/powerbi-report-authoring-cli": "^0.5.0"
	}
}